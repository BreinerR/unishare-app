# ==============================================================================
# UNISHARE - BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=5000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unishare_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_MAX_CONNECTIONS=20
DB_SSL=false

# Autenticación y Seguridad (JWT / Firebase)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:8081
